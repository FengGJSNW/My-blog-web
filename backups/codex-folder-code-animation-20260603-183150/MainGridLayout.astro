            var indicator = null;
            var wallpaperWrapper = null;
            var mainArea = null;
            var topRow = null;
            var navbar = null;
            var overlayTargetBlur = 0;
            var lastEased = -1;
            var lastNavAlpha = '';
            var lastBlur = '';
            var lastOverlayTransform = '';
            var lastOverlayOpacity = '';
            var lastIndicatorTransform = '';
            var lastIndicatorOpacity = '';

            function isLowPowerVisualDevice() {
                var nav = navigator || {};
                return (
                    window.matchMedia('(pointer: coarse)').matches ||
                    window.innerWidth < 768 ||
                    (typeof nav.hardwareConcurrency === 'number' && nav.hardwareConcurrency <= 4) ||
                    (typeof nav.deviceMemory === 'number' && nav.deviceMemory <= 4) ||
                    window.matchMedia('(prefers-reduced-motion: reduce)').matches
