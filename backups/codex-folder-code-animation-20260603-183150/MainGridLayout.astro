    </div>
    ) : null}
</div>
)}

{/* 当壁纸未渲染时，添加空的 Swup 占位容器，避免 Swup 找不到容器而回退为整页加载 */}
{!(isWallpaperSwitchable || isBannerMode || isFullscreenMode || isOverlayMode) && (
<>
    <div id="banner-overlay-container" class="hidden"></div>
    <div id="banner-dim-container" class="hidden"></div>
</>
)}

<!-- Main content -->
<div id="posts" class={`absolute w-full z-30 pointer-events-none ${mobileNonHomeBannerClass ? 'mobile-main-no-banner' : ''} ${isOverlayFusionHome ? 'overlay-fusion-main' : ''} ${!(isBannerMode && isBackgroundEnabled) ? 'no-banner-layout' : ''}`} style={`${isOverlayFusionHome ? 'top: calc(100vh + 1rem);' : isFullscreenMode ? 'top: 0;' : `top: ${finalMainPanelTop}`}; scroll-margin-top: 5.5rem;`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative w-full xl:w-[92vw] max-w-(--page-width) mx-auto pointer-events-auto">
        <div id="main-grid"
          class={`transition duration-700 w-full left-0 right-0 grid ${gridCols} grid-rows-[auto_1fr_auto] lg:grid-rows-[auto] mx-auto gap-4 px-2 md:px-4 ${!sidebarConfig.mobileShowSidebar ? 'mobile-no-sidebar' : ''}`}
          data-sidebar-position={sidebarLayoutConfig.position}
          data-tablet-sidebar={sidebarLayoutConfig.tabletSidebar ?? "left"}
          data-show-both-sidebars-on-post={sidebarLayoutConfig.showBothSidebarsOnPostPage ? "true" : "false"}
        >

            {/* 渲染左侧边栏 - 根据position和tabletSidebar配置显示 */}
            {/*
                如果全局配置为双侧栏(position: both)或仅左侧栏(position: left)，则使用静态容器(不被swup替换)，避免闪烁。
                如果全局配置为仅右侧栏(position: right)，则使用动态容器(被swup替换)，以便在文章页显示左侧栏。
                注意：为了满足swup要求所有containers必须存在，我们在所有模式下都必须渲染 #left-sidebar-dynamic。
            */}
            {sidebarLayoutConfig.position !== "right" ? (
                <>
                    <div id="left-sidebar-wrapper" class="contents" style="contain: layout style paint;">
                        {effectiveHasLeftComponents && (
                            <SideBar
                                side={effectiveIsBothSidebars ? "left" : undefined}
                                class={sidebarClass}
                                headings={headings}
                            />
                        )}
                    </div>
                    <div id="left-sidebar-dynamic" class="hidden transition-swup-fade"></div>
                </>
            ) : (
                <div id="left-sidebar-dynamic" class="contents transition-swup-fade">
                    {effectiveIsBothSidebars && effectiveHasLeftComponents && (
						<SideBar side="left" class={sidebarClass} headings={headings}></SideBar>
                    )}
                </div>
            )}
                    
            {/* 主内容区包装器 - 包含静态栏位和swup容器，作为单个grid item */}
            <div class={staticBarClass}>
                {/* 分类导航栏 - 全站渲染并显示 */}
                {shouldRenderCategoryBar && <div id="category-bar-wrapper"><CategoryBar currentPostCategory={postCategory} /></div>}
                {/* 主内容区 - 始终渲染，确保 Swup 容器存在 */}
                <main
                    id="swup-container"
                    class="transition-main"
                    data-current-post-category={postCategory || ""}
                >
                {/* 携带网格布局类名，用于JS更新父容器 */}
                <div id="grid-class-carrier" data-grid-class={gridCols} class="hidden"></div>
                {/* 为每个页面提供一个隐藏的h1标题，用于SEO和可访问性 */}
                <h1 class="sr-only">{title}</h1>
                <div id="content-wrapper" class="onload-animation transition-leaving">
                    <slot></slot>
                </div>
            </main>
            </div>

            {/* 右侧边栏 - 双侧边栏模式或仅右侧栏模式 */}
            {/*
                如果全局配置为双侧栏(position: both)或仅右侧栏(position: right)，则使用静态容器(不被swup替换)，避免闪烁。
                如果全局配置为单侧栏(position: left)，则使用动态容器(被swup替换)，以便在文章页显示右侧栏。
                注意：为了满足swup要求所有containers必须存在，我们在所有模式下都必须渲染 #right-sidebar-dynamic。
                右侧边栏的显示由CSS类控制。
            */}
            {(sidebarLayoutConfig.position === "both" || sidebarLayoutConfig.position === "right") ? (
                <>
                    <div id="right-sidebar-static" class="contents">
                        {(effectiveIsBothSidebars || sidebarLayoutConfig.position === "right") && effectiveHasRightComponents && (
							<SideBar side="right" class={rightSidebarClass} headings={headings}></SideBar>
                        )}
                    </div>
                    <div id="right-sidebar-dynamic" class="hidden transition-swup-fade"></div>
                </>
            ) : (
                <div id="right-sidebar-dynamic" class="contents transition-swup-fade">
                    {effectiveIsBothSidebars && effectiveHasRightComponents && (
						<SideBar side="right" class={rightSidebarClass} headings={headings}></SideBar>
                    )}
                </div>
            )}

            {/* 移动端底部组件 - 768px及以下显示 */}
            {sidebarLayoutConfig.mobileBottomComponents && sidebarLayoutConfig.mobileBottomComponents.length > 0 && (
                <div id="mobile-bottom-sidebar" class="col-span-1 block md:hidden mt-4">
					<SideBar side="bottom" headings={headings}></SideBar>
                </div>
            )}

            <div class={footerClassName}>
                <Footer></Footer>
            </div>
        </div>

        <SpineModel></SpineModel>
        {live2dModelConfig.enable && <Live2DWidget config={live2dModelConfig} />}
    </div>
</div>

<FloatingControls headings={headings} />

<script is:inline data-swup-ignore-script>
  (() => {
    if (window.__fireflyCodeCollapseAnimationInitialized) return;
    window.__fireflyCodeCollapseAnimationInitialized = true;

    const reducedMotion = () =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const activeAnimations = new WeakMap();
    const COLLAPSE_LINE_THRESHOLD = 10;
    const EXPANDED_CODE_VIEWPORT_LINES = 30;

    const forceScrollBy = (delta) => {
      const root = document.documentElement;
      const previousScrollBehavior = root.style.scrollBehavior;
      root.style.scrollBehavior = "auto";
      window.scrollTo(0, (window.scrollY || root.scrollTop || 0) + delta);
      root.style.scrollBehavior = previousScrollBehavior;
    };

    const createScrollStabilizer = (anchor) => {
      if (!anchor) return () => {};

      let running = true;
      let animationFrame = 0;
      let lastTop = anchor.getBoundingClientRect().top;

      const keepStable = () => {
        if (!running) return;

        const nextTop = anchor.getBoundingClientRect().top;
        const delta = nextTop - lastTop;
        if (Math.abs(delta) > 0.5) {
          forceScrollBy(delta);
        }

        lastTop = anchor.getBoundingClientRect().top;
        animationFrame = window.requestAnimationFrame(keepStable);
      };

      animationFrame = window.requestAnimationFrame(keepStable);

      return () => {
        running = false;
        window.cancelAnimationFrame(animationFrame);
      };
    };

    const getCodeLineCount = (owner) => {
      const lineNodes = owner.querySelectorAll(".ec-line, .code .line, code .line");
      if (lineNodes.length > 0) return lineNodes.length;

      const pre = owner.querySelector("pre");
      const rawCode = pre?.querySelector("code")?.textContent || pre?.textContent || "";
      const normalized = rawCode.replace(/\n$/, "");
      return normalized ? normalized.split(/\r?\n/).length : 0;
    };

    const getCodeLanguage = (owner) => {
      const language =
        owner.querySelector("[data-language]")?.getAttribute("data-language") ||
        owner.querySelector("pre[class*='language-']")?.className.match(/language-([^\s]+)/)?.[1] ||
        "text";
      return language === "plaintext" ? "text" : language;
    };

    const inferLanguageFromTitle = (title, fallback) => {
      const value = String(title || "").trim().toLowerCase();
      if (value.endsWith(".py")) return "python";
      if (value.endsWith(".js") || value.endsWith(".mjs") || value.endsWith(".cjs")) return "javascript";
      if (value.endsWith(".ts")) return "typescript";
      if (value.endsWith(".cpp") || value.endsWith(".cc") || value.endsWith(".cxx")) return "cpp";
      if (value.endsWith(".c")) return "c";
      if (value.endsWith(".java")) return "java";
      if (value.endsWith(".sh") || value.endsWith(".bash")) return "bash";
      if (value.endsWith(".ps1")) return "powershell";
      return fallback;
    };

    const normalizeCodeTitle = (value) =>
      String(value || "")
        .replace(/^\s*#\s*/, "")
        .trim();

    const getFrameTitle = (owner) => {
      const titleNode = owner.querySelector(".frame .header .title");
      return normalizeCodeTitle(titleNode?.textContent || "");
    };

    const getCodeLineText = (line) =>
      (line?.querySelector?.(".code")?.textContent || line?.textContent || "").trim();

    const extractInlineFilenameTitle = (owner) => {
      const firstLine = owner.querySelector(".ec-line, .code .line, code .line");
      const raw = getCodeLineText(firstLine);
      const title = normalizeCodeTitle(raw);
      if (!/^[\w.-]+\.[A-Za-z0-9]+$/.test(title)) return "";

      firstLine.classList.add("ec-code-title-line");
      firstLine.setAttribute("aria-hidden", "true");
      return title;
    };

    const getCollapsedPreviewLines = (lineCount) =>
      Math.max(1, Math.floor(Math.log2(Math.max(1, lineCount - 9)) + 6));

    const getCodeLineHeight = (owner) => {
      const line = owner.querySelector(".ec-line, .code .line, code .line");
      const lineRect = line?.getBoundingClientRect();
      if (lineRect && lineRect.height > 0) return lineRect.height;

      const pre = owner.querySelector("pre");
      const parsed = pre ? Number.parseFloat(getComputedStyle(pre).lineHeight) : NaN;
      return Number.isFinite(parsed) && parsed > 0 ? parsed : 24;
    };

    const getCodePreviewHeight = (wrapper, lineCount) => {
      const content = wrapper.querySelector(".ec-collapse__content") || wrapper;
      const lines = Array.from(
        content.querySelectorAll(".ec-line, .code .line, code .line"),
      ).filter((line) => !line.classList.contains("ec-code-title-line"));
      const previewLines = getCollapsedPreviewLines(lineCount);
      const targetLine = lines[Math.min(previewLines, lines.length) - 1];
      if (targetLine) {
        const contentTop = content.getBoundingClientRect().top;
        const lineBottom = targetLine.getBoundingClientRect().bottom;
        const pre = content.querySelector("pre");
        const paddingBottom = pre
          ? Number.parseFloat(getComputedStyle(pre).paddingBottom) || 0
          : 0;
        const measuredHeight = lineBottom - contentTop + paddingBottom + 2;
        if (measuredHeight > 0) return Math.ceil(measuredHeight);
      }

      const pre = content.querySelector("pre");
      const styles = pre ? getComputedStyle(pre) : null;
      const paddingTop = styles ? Number.parseFloat(styles.paddingTop) || 0 : 0;
      const paddingBottom = styles ? Number.parseFloat(styles.paddingBottom) || 0 : 0;
      const frameHeader = content.querySelector(".header")?.getBoundingClientRect().height || 0;
      return Math.ceil(
        frameHeader +
          getCodeLineHeight(content) * previewLines +
          paddingTop +
          paddingBottom,
      );
    };

    const getCodeViewportHeight = (wrapper, lineCount, lineLimit) => {
      const content = wrapper.querySelector(".ec-collapse__content") || wrapper;
      const lines = Array.from(
        content.querySelectorAll(".ec-line, .code .line, code .line"),
      ).filter((line) => !line.classList.contains("ec-code-title-line"));
      const targetLineCount = Math.min(lineLimit, lineCount, lines.length);
      const targetLine = lines[Math.max(0, targetLineCount - 1)];
      if (targetLine) {
        const contentTop = content.getBoundingClientRect().top;
        const lineBottom = targetLine.getBoundingClientRect().bottom;
        const pre = content.querySelector("pre");
        const paddingBottom = pre
          ? Number.parseFloat(getComputedStyle(pre).paddingBottom) || 0
          : 0;
        const measuredHeight = lineBottom - contentTop + paddingBottom + 2;
        if (measuredHeight > 0) return Math.ceil(measuredHeight);
      }

      const pre = content.querySelector("pre");
      const styles = pre ? getComputedStyle(pre) : null;
      const paddingTop = styles ? Number.parseFloat(styles.paddingTop) || 0 : 0;
      const paddingBottom = styles ? Number.parseFloat(styles.paddingBottom) || 0 : 0;
      return Math.ceil(
        getCodeLineHeight(content) * Math.min(lineLimit, lineCount) +
          paddingTop +
          paddingBottom,
      );
    };

    const getExpandedHeight = (wrapper) => {
      const rawHeight = wrapper.style.getPropertyValue("--ec-collapse-expanded-height");
      const parsedHeight = Number.parseFloat(rawHeight);
      if (Number.isFinite(parsedHeight) && parsedHeight > 0) return parsedHeight;
      return wrapper.querySelector(".ec-collapse__content")?.scrollHeight || 0;
    };

    const getPreviewHeight = (wrapper) => {
      const styles = getComputedStyle(wrapper);
      const rawHeight = styles.getPropertyValue("--ec-collapse-preview-height").trim();
      const parsedHeight = Number.parseFloat(rawHeight);
      if (Number.isFinite(parsedHeight) && parsedHeight > 0) return parsedHeight;

      const lineCount = Number.parseInt(wrapper.dataset.ecLineCount || "", 10);
      if (Number.isFinite(lineCount) && lineCount > COLLAPSE_LINE_THRESHOLD) {
        return getCodePreviewHeight(wrapper, lineCount);
      }

      return 280;
    };

    const normalizeCodeWheelDelta = (event, owner, value) => {
      if (event.deltaMode === WheelEvent.DOM_DELTA_LINE) {
        const lineHeight = Number.parseFloat(getComputedStyle(owner).lineHeight);
        return value * (Number.isFinite(lineHeight) && lineHeight > 0 ? lineHeight : 18);
      }
      if (event.deltaMode === WheelEvent.DOM_DELTA_PAGE) {
        return value * owner.clientHeight;
      }
      return value;
    };

    const isActiveCodeScroller = (content) =>
      content?.closest(".ec-collapse--expanded.ec-collapse--scrollable");

    const handleContainedCodeWheel = (event) => {
      const content = event.currentTarget;
      if (!isActiveCodeScroller(content)) return;

      event.preventDefault();
      event.stopPropagation();

      const shiftHorizontal = event.shiftKey && Math.abs(event.deltaY) >= Math.abs(event.deltaX);
      const deltaX = normalizeCodeWheelDelta(
        event,
        content,
        event.deltaX + (shiftHorizontal ? event.deltaY : 0),
      );
      const deltaY = shiftHorizontal ? 0 : normalizeCodeWheelDelta(event, content, event.deltaY);
      content.scrollLeft += deltaX;
      content.scrollTop += deltaY;
    };

    const handleContainedCodeTouchStart = (event) => {
      const touch = event.touches?.[0];
      if (!touch) return;
      event.currentTarget.dataset.ecContainTouchY = String(touch.clientY);
      event.currentTarget.dataset.ecContainTouchX = String(touch.clientX);
    };

    const handleContainedCodeTouchMove = (event) => {
      const content = event.currentTarget;
      const touch = event.touches?.[0];
      if (!touch || !isActiveCodeScroller(content)) return;

      const previousY = Number.parseFloat(content.dataset.ecContainTouchY || "");
      const previousX = Number.parseFloat(content.dataset.ecContainTouchX || "");
      content.dataset.ecContainTouchY = String(touch.clientY);
      content.dataset.ecContainTouchX = String(touch.clientX);
      if (!Number.isFinite(previousY) || !Number.isFinite(previousX)) return;

      const deltaY = previousY - touch.clientY;
      const deltaX = previousX - touch.clientX;
      if (Math.abs(deltaX) > Math.abs(deltaY)) return;

      event.preventDefault();
      event.stopPropagation();
      content.scrollTop += deltaY;
    };

    const bindContainedCodeScroll = (content) => {
      if (!content || content.dataset.ecContainedScrollInit === "true") return;
      content.dataset.ecContainedScrollInit = "true";
      content.addEventListener("wheel", handleContainedCodeWheel, { passive: false });
      content.addEventListener("touchstart", handleContainedCodeTouchStart, { passive: true });
      content.addEventListener("touchmove", handleContainedCodeTouchMove, { passive: false });
    };

    const runCodeHeightAnimation = (content, fromHeight, toHeight, finish) => {
      const previousCleanup = activeAnimations.get(content);
      if (previousCleanup) previousCleanup();

      let fallbackTimer;
      let frameOne = 0;
      let frameTwo = 0;
      let done = false;

      const cleanup = () => {
        if (done) return;
        done = true;
        content.removeEventListener("transitionend", onTransitionEnd);
        window.clearTimeout(fallbackTimer);
        if (frameOne) cancelAnimationFrame(frameOne);
        if (frameTwo) cancelAnimationFrame(frameTwo);
        activeAnimations.delete(content);
        finish();
      };
      const onTransitionEnd = (event) => {
        if (event.propertyName === "height") cleanup();
      };

      content.style.setProperty("transition", "none", "important");
      content.style.setProperty("height", `${Math.max(0, fromHeight)}px`, "important");
      content.style.setProperty("max-height", "none", "important");
      content.style.setProperty("overflow-y", "hidden", "important");

      if (reducedMotion() || Math.abs(toHeight - fromHeight) <= 1) {
        cleanup();
        return;
      }

      activeAnimations.set(content, cleanup);
      content.addEventListener("transitionend", onTransitionEnd);
      frameOne = requestAnimationFrame(() => {
        content.style.removeProperty("transition");
        frameTwo = requestAnimationFrame(() => {
          content.style.setProperty("height", `${Math.max(0, toHeight)}px`, "important");
        });
      });
      fallbackTimer = window.setTimeout(cleanup, 680);
    };

    const blockWheelEvents = (duration) => {
      const prevent = (event) => event.preventDefault();
      window.addEventListener("wheel", prevent, { passive: false });
      window.addEventListener("touchmove", prevent, { passive: false });
      return window.setTimeout(() => {
        window.removeEventListener("wheel", prevent);
        window.removeEventListener("touchmove", prevent);
      }, duration);
    };

    const blockScrollInterference = (duration) => {
      const root = document.documentElement;
      const body = document.body;
      const previousRootAnchor = root.style.overflowAnchor;
      const previousBodyAnchor = body.style.overflowAnchor;
      root.style.overflowAnchor = "none";
      body.style.overflowAnchor = "none";
      blockWheelEvents(duration);
      return window.setTimeout(() => {
        root.style.overflowAnchor = previousRootAnchor;
        body.style.overflowAnchor = previousBodyAnchor;
      }, duration);
    };

    const scrollCodeBlockToTop = (wrapper, options = {}) => {
      const topOffset = 88;
      const block = wrapper.closest(".expressive-code") || wrapper;
      const folderBody = wrapper.closest(".folded-block__body");
      const behavior = options.behavior || (reducedMotion() ? "auto" : "smooth");
      const blockDuration = behavior === "smooth" ? 420 : 80;
      if (options.lockWheel !== false) blockWheelEvents(blockDuration);

      if (folderBody && folderBody.scrollHeight > folderBody.clientHeight) {
        const bodyRect = folderBody.getBoundingClientRect();
        const wrapperRect = block.getBoundingClientRect();
        folderBody.scrollTo({
          top: Math.max(0, folderBody.scrollTop + wrapperRect.top - bodyRect.top - 12),
          behavior,
        });
      }

      const root = document.documentElement;
      const targetTop =
        block.getBoundingClientRect().top + (window.scrollY || root.scrollTop || 0) - topOffset;
      window.scrollTo({ top: Math.max(0, targetTop), behavior });
    };

    const getCodeBlockWindowTargetTop = (wrapper) => {
      const topOffset = 88;
      const block = wrapper.closest(".expressive-code") || wrapper;
      const root = document.documentElement;
      return Math.max(
        0,
        block.getBoundingClientRect().top + (window.scrollY || root.scrollTop || 0) - topOffset,
      );
    };

    const scrollCodeBlockToTopThen = (wrapper, callback) => {
      if (reducedMotion()) {
        scrollCodeBlockToTop(wrapper, { behavior: "auto", lockWheel: false });
        callback();
        return;
      }

      const targetTop = getCodeBlockWindowTargetTop(wrapper);
      const startedAt = performance.now();
      const maxDuration = 900;
      let done = false;
      blockScrollInterference(maxDuration + 120);
      scrollCodeBlockToTop(wrapper, { behavior: "smooth", lockWheel: false });

      const finish = () => {
        if (done) return;
        done = true;
        callback();
      };

      const tick = () => {
        const currentTop = window.scrollY || document.documentElement.scrollTop || 0;
        if (Math.abs(currentTop - targetTop) <= 3 || performance.now() - startedAt > maxDuration) {
          finish();
          return;
        }
        requestAnimationFrame(tick);
      };

      requestAnimationFrame(tick);
    };

    const syncCodeToggleState = (wrapper, expanded) => {
      wrapper
        .querySelectorAll(".ec-collapse__toggle, .ec-collapse__header-toggle")
        .forEach((toggle) => {
          toggle.setAttribute("aria-expanded", expanded ? "true" : "false");
          toggle.setAttribute(
            "aria-label",
            expanded ? "\u6536\u8d77\u4ee3\u7801\u5757" : "\u5c55\u5f00\u4ee3\u7801\u5757",
          );
          toggle.setAttribute(
            "title",
            expanded ? "\u6536\u8d77\u4ee3\u7801\u5757" : "\u5c55\u5f00\u4ee3\u7801\u5757",
          );
        });
    };
    const enhanceCodeBlocks = () => {
      document.querySelectorAll(".expressive-code").forEach((block) => {
        const wrapper = block.querySelector(".ec-collapse");
        const owner = wrapper || block;
        const rawLineCount = getCodeLineCount(owner);
        const explicitTitle = getFrameTitle(owner);
        const inlineTitle = explicitTitle || extractInlineFilenameTitle(owner);
        const lineCount = Math.max(0, rawLineCount - (!explicitTitle && inlineTitle ? 1 : 0));
        const language = inferLanguageFromTitle(inlineTitle, getCodeLanguage(owner));
        const typeLabel = language ? language.toUpperCase() : "TEXT";
        const lineLabel = `${lineCount} \u884c${language === "text" ? "\u6587\u672c" : "\u4ee3\u7801"}`;
        const collapsible = Boolean(wrapper && lineCount > COLLAPSE_LINE_THRESHOLD);
        const scrollableExpanded = Boolean(
          wrapper && lineCount > EXPANDED_CODE_VIEWPORT_LINES,
        );
        const previewLines = getCollapsedPreviewLines(lineCount);
        const statusbarParent = block;
        const statusbarBefore = block.firstElementChild;

        block.classList.add("ec-code-enhanced");
        block.classList.toggle("ec-code-enhanced--collapsible", collapsible);
        if (wrapper) {
          const content = wrapper.querySelector(".ec-collapse__content");
          wrapper.dataset.ecLineCount = String(lineCount);
          wrapper.dataset.collapsePreviewLines = String(previewLines);
          wrapper.dataset.heightInit = "firefly";
          wrapper.classList.toggle("ec-collapse--scrollable", scrollableExpanded);
          bindContainedCodeScroll(content);
          wrapper.style.setProperty(
            "--ec-collapse-preview-height",
            `${getCodePreviewHeight(wrapper, lineCount)}px`,
          );
          wrapper.style.setProperty(
            "--ec-collapse-expanded-height",
            `${getCodeViewportHeight(
              wrapper,
              lineCount,
              EXPANDED_CODE_VIEWPORT_LINES,
            )}px`,
          );
          if (lineCount <= COLLAPSE_LINE_THRESHOLD) {
            wrapper.classList.remove("ec-collapse--collapsed");
            wrapper.classList.add("ec-collapse--expanded", "ec-collapse--short");
            wrapper.classList.remove("ec-collapse--scrollable");
            content?.style.setProperty(
              "max-height",
              "none",
              "important",
            );
          } else {
            wrapper.classList.remove("ec-collapse--short");
          }
        }

        let statusbar = block.querySelector(".ec-code-statusbar");
        if (!statusbar) {
          statusbar = document.createElement("div");
          statusbar.className = "ec-code-statusbar";
        }
        if (statusbar.parentElement !== statusbarParent) {
          statusbarParent.insertBefore(statusbar, statusbarBefore);
        }

        let meta = statusbar.querySelector(".ec-code-statusbar__meta");
        if (!meta) {
          meta = document.createElement("div");
          meta.className = "ec-code-statusbar__meta";
          statusbar.appendChild(meta);
        }
        meta.innerHTML = "";

        let traffic = statusbar.querySelector(".ec-code-statusbar__traffic");
        if (!traffic) {
          traffic = document.createElement("div");
          traffic.className = "ec-code-statusbar__traffic";
          traffic.setAttribute("aria-hidden", "true");
          traffic.innerHTML =
            '<span class="ec-code-statusbar__dot ec-code-statusbar__dot--red"></span><span class="ec-code-statusbar__dot ec-code-statusbar__dot--yellow"></span><span class="ec-code-statusbar__dot ec-code-statusbar__dot--green"></span>';
        }
        if (traffic.parentElement !== statusbar || statusbar.firstElementChild !== traffic) {
          statusbar.insertBefore(traffic, statusbar.firstElementChild);
        }

        let tabs = statusbar.querySelector(".ec-code-statusbar__tabs");
        if (!tabs) {
          tabs = document.createElement("div");
          tabs.className = "ec-code-statusbar__tabs";
        }
        if (tabs.parentElement !== statusbar || tabs.previousElementSibling !== traffic) {
          statusbar.insertBefore(tabs, traffic.nextElementSibling);
        }
        if (meta.parentElement !== statusbar || meta.previousElementSibling !== tabs) {
          statusbar.appendChild(meta);
        }
        tabs.innerHTML = "";
        tabs.toggleAttribute("hidden", !inlineTitle);
        if (inlineTitle) {
          const titleNode = document.createElement("span");
          titleNode.className = "ec-code-statusbar__tab";
          titleNode.textContent = inlineTitle;
          titleNode.setAttribute("title", inlineTitle);
          tabs.append(titleNode);
        }

        const typeNode = document.createElement("span");
        typeNode.className = "ec-code-statusbar__language";
        typeNode.textContent = typeLabel;
        const countNode = document.createElement("span");
        countNode.className = "ec-code-statusbar__count";
        countNode.textContent = lineLabel;
        meta.append(typeNode, countNode);

        if (collapsible) {
          syncCodeToggleState(wrapper, wrapper.classList.contains("ec-collapse--expanded"));
        }
      });
    };

    const scheduleCodeBlockEnhance = () => {
      requestAnimationFrame(enhanceCodeBlocks);
      window.setTimeout(enhanceCodeBlocks, 80);
      window.setTimeout(enhanceCodeBlocks, 260);
    };

    const animateCodeCollapse = (button) => {
      const wrapper = button.closest(".ec-collapse");
      const content = wrapper?.querySelector(".ec-collapse__content");
      if (!wrapper || !content) return;

      const wasCollapsed = wrapper.classList.contains("ec-collapse--collapsed");
      const willExpand = wasCollapsed;

      if (!willExpand && button.dataset.ecCollapseAfterScroll !== "true") {
        if (wrapper.dataset.ecCollapsePending === "true") return;
        wrapper.dataset.ecCollapsePending = "true";
        syncCodeToggleState(wrapper, true);
        scrollCodeBlockToTopThen(wrapper, () => {
          delete wrapper.dataset.ecCollapsePending;
          button.dataset.ecCollapseAfterScroll = "true";
          animateCodeCollapse(button);
          delete button.dataset.ecCollapseAfterScroll;
        });
        return;
      }

      if (!willExpand) {
        const fromHeight = wrapper.classList.contains("ec-collapse--scrollable")
          ? getExpandedHeight(wrapper)
          : content.getBoundingClientRect().height;
        const toHeight = getPreviewHeight(wrapper);
        content.scrollTop = 0;
        wrapper.classList.remove("ec-collapse--expanded");
        wrapper.classList.add("ec-collapse--collapsed");
        syncCodeToggleState(wrapper, false);

        runCodeHeightAnimation(content, fromHeight, toHeight, () => {
          content.scrollTop = 0;
          content.style.removeProperty("height");
          content.style.removeProperty("max-height");
          content.style.removeProperty("overflow-y");
        });
        return;
      }

      const scrollableWillExpand = wrapper.classList.contains("ec-collapse--scrollable");
      const fromHeight = getPreviewHeight(wrapper);
      const toHeight = scrollableWillExpand ? getExpandedHeight(wrapper) : content.scrollHeight;
      wrapper.classList.remove("ec-collapse--collapsed");
      wrapper.classList.add("ec-collapse--expanded");
      syncCodeToggleState(wrapper, true);

      runCodeHeightAnimation(content, fromHeight, toHeight, () => {
        content.style.removeProperty("height");
        if (scrollableWillExpand) {
          content.style.setProperty(
            "max-height",
            `${getExpandedHeight(wrapper)}px`,
            "important",
          );
          content.style.removeProperty("overflow-y");
        } else {
          content.style.setProperty("max-height", "none", "important");
          content.style.removeProperty("overflow-y");
        }
      });
    };

    const resolveCssLength = (value, owner) => {
      const trimmed = String(value || "").trim();
      const parsed = Number.parseFloat(trimmed);
      if (!trimmed || !Number.isFinite(parsed)) return null;
      if (trimmed.endsWith("px") || /^\d+(?:\.\d+)?$/.test(trimmed)) return parsed;

      const probe = document.createElement("div");
      probe.style.position = "absolute";
      probe.style.visibility = "hidden";
      probe.style.pointerEvents = "none";
      probe.style.height = trimmed;
      owner.appendChild(probe);
      const height = probe.getBoundingClientRect().height;
      probe.remove();
      return height > 0 ? height : null;
    };

    const getFolderTargetHeight = (details, body) => {
      const styles = getComputedStyle(details);
      const rawHeight =
        styles.getPropertyValue("--folded-block-scroll-height").trim() || "28rem";
      const configuredHeight = resolveCssLength(rawHeight, details);
      return Math.min(body.scrollHeight, configuredHeight || body.scrollHeight);
    };

    const animateStyle3Folder = (summary) => {
      const details = summary.closest(".folded-block--style-3");
      const body = details?.querySelector(".folded-block__body");
      if (!details || !body) return false;

      const previousCleanup = activeAnimations.get(body);
      if (previousCleanup) previousCleanup();

      const isOpen = details.hasAttribute("open");
      if (reducedMotion()) {
        if (isOpen) {
          details.removeAttribute("open");
        } else {
          details.setAttribute("open", "");
        }
        return true;
      }

      const stopScrollStabilizer = createScrollStabilizer(details);
      details.classList.add("folded-block--animating");

      if (!isOpen) {
        details.setAttribute("open", "");
        body.style.setProperty("max-height", "0px");
        body.style.setProperty("opacity", "0");
        body.getBoundingClientRect();

        const targetHeight = getFolderTargetHeight(details, body);
        requestAnimationFrame(() => {
          body.style.setProperty("max-height", `${targetHeight}px`);
          body.style.setProperty("opacity", "1");
        });
      } else {
        const fromHeight = body.getBoundingClientRect().height;
        body.style.setProperty("max-height", `${fromHeight}px`);
        body.style.setProperty("opacity", "1");
        body.getBoundingClientRect();

        requestAnimationFrame(() => {
          body.style.setProperty("max-height", "0px");
          body.style.setProperty("opacity", "0");
        });
      }

      let fallbackTimer;
      const cleanup = () => {
        body.removeEventListener("transitionend", onTransitionEnd);
        window.clearTimeout(fallbackTimer);
        stopScrollStabilizer();
        activeAnimations.delete(body);
        details.classList.remove("folded-block--animating");
        body.style.removeProperty("max-height");
        body.style.removeProperty("opacity");
        if (isOpen) {
          details.removeAttribute("open");
        }
      };
      const onTransitionEnd = (event) => {
        if (event.propertyName === "max-height") cleanup();
      };

      activeAnimations.set(body, cleanup);
      body.addEventListener("transitionend", onTransitionEnd);
      fallbackTimer = window.setTimeout(cleanup, 620);
      return true;
    };

    document.addEventListener(
      "click",
      (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const folderSummary = target.closest(
          ".folded-block--style-3 > .folded-block__summary",
        );
        if (folderSummary) {
          event.preventDefault();
          event.stopPropagation();
          animateStyle3Folder(folderSummary);
          return;
        }

        const button = target.closest(
          ".ec-collapse__toggle, .ec-collapse__header-toggle",
        );
        if (!button) return;

        event.preventDefault();
        event.stopPropagation();
        animateCodeCollapse(button);
      },
      true,
    );

    scheduleCodeBlockEnhance();
    document.addEventListener("astro:page-load", scheduleCodeBlockEnhance);
    document.addEventListener("swup:contentReplaced", scheduleCodeBlockEnhance);
    document.addEventListener("password:decrypted", scheduleCodeBlockEnhance);
  })();
</script>


</Layout>

<style is:global>
  /* 右侧栏平滑过渡 */
  #right-sidebar {
    transition: opacity 0.35s ease-in-out,
                transform 0.35s ease-in-out;
  }

  @keyframes swupFadeOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.95;
    }
  }

</style>

