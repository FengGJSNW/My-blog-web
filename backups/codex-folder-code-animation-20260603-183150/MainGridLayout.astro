                mainArea = document.getElementById('posts')
                    || document.querySelector('.w-full.z-30.pointer-events-none');
                topRow = document.getElementById('top-row');
                navbar = document.getElementById('navbar-wrapper');

                if (wallpaperWrapper) {
                    var cssBlur = getComputedStyle(wallpaperWrapper).getPropertyValue('--overlay-blur').trim();
