            var snapTimer = null;
            var snapFollowFrame = 0;
            var snapFollowUntil = 0;
            var isAutoScrolling = false;
            var suppressSnapUntil = 0;
            var lastScrollY = window.scrollY || document.documentElement.scrollTop || 0;
