            function snapIfInTransitionZone() {
                if (!isOverlayHome() || isAutoScrolling) return;
                if (Date.now() < suppressSnapUntil) return;
                var targetY = getCardSnapY();
                if (targetY === null || targetY < 40) return;
                var y = window.scrollY || document.documentElement.scrollTop || 0;
                var clearEdge = Math.max(10, Math.min(18, window.innerHeight * 0.018));
                var cardTopTolerance = Math.max(18, Math.min(36, window.innerHeight * 0.04));
