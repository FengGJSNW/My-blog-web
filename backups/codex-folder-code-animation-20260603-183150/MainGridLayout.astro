            function updateTitleScroll() {
                ticking = false;
                if (!overlay) return;

                if (!isOverlayHome()) {
                    lastEased = -1;
                    if (lastOverlayTransform !== '') {
                        overlay.style.transform = '';
                        lastOverlayTransform = '';
                    }
                    if (lastOverlayOpacity !== '') {
                        overlay.style.opacity = '';
                        lastOverlayOpacity = '';
                    }
                    if (lastNavAlpha !== '') {
                        document.documentElement.style.removeProperty('--overlay-fusion-nav-alpha');
                        lastNavAlpha = '';
                    }
                    if (wallpaperWrapper) {
                        wallpaperWrapper.style.removeProperty('--overlay-fusion-blur');
                        lastBlur = '';
                    }
                    if (indicator) {
                        indicator.style.opacity = '';
                        indicator.style.transform = '';
                        lastIndicatorOpacity = '';
                        lastIndicatorTransform = '';
                    }
                    return;
                }

                var scrollTop = window.scrollY || document.documentElement.scrollTop || 0;
                var viewport = Math.max(window.innerHeight || 0, 1);
