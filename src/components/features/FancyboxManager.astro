---
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import "@/styles/fancybox-custom.css";
---

<script>
  let Fancybox: any;
  let setupToken = 0;

  const blurLinkSelector = ".blur-image-link";
  const blurBoundSelector = ".blur-image-link[data-fancybox]";
  const rawImageSelector =
    ".custom-md img:not(.blur-image-placeholder):not([data-responsive-image]), #post-cover img, .moment-images img";
  const momentLinkSelector = ".moment-images a[data-fancybox]";
  const otherFancyboxSelector =
    "[data-fancybox]:not(.moment-images a):not(.blur-image-link)";

  function isLocalSvgUrl(value?: string | null) {
    if (!value) return false;
    const src = value.toLowerCase();
    return (
      src.includes("/__local_svg/") ||
      src.includes("/assets/local-svg/") ||
      /\.svg(?:[?#]|$)/i.test(src)
    );
  }

  function markLocalSvgFancybox() {
    document.querySelectorAll<HTMLImageElement>(".fancybox__container img").forEach((image) => {
      const src =
        image.currentSrc ||
        image.src ||
        image.getAttribute("data-lazy-src") ||
        image.getAttribute("src") ||
        "";

      if (!isLocalSvgUrl(src)) return;

      image.setAttribute("data-firefly-local-svg", "true");
      image
        .closest<HTMLElement>(".f-carousel__slide, .fancybox__slide")
        ?.classList.add("firefly-fancybox-svg-slide");
      image
        .closest<HTMLElement>(".f-panzoom__viewport, .f-panzoom__wrapper")
        ?.classList.add("firefly-fancybox-svg-frame");
    });
  }

  function scheduleLocalSvgFancyboxMark() {
    requestAnimationFrame(markLocalSvgFancybox);
    window.setTimeout(markLocalSvgFancybox, 120);
    window.setTimeout(markLocalSvgFancybox, 600);
  }

  const commonOptions = {
    Thumbs: {
      autoStart: true,
      showOnStart: "yes",
    },
    Toolbar: {
      display: {
        left: ["infobar"],
        middle: [
          "zoomIn",
          "zoomOut",
          "toggle1to1",
          "rotateCCW",
          "rotateCW",
          "flipX",
          "flipY",
        ],
        right: ["slideshow", "thumbs", "close"],
      },
    },
    animated: true,
    dragToClose: true,
    keyboard: {
      Escape: "close",
      Delete: "close",
      Backspace: "close",
      PageUp: "next",
      PageDown: "prev",
      ArrowUp: "next",
      ArrowDown: "prev",
      ArrowRight: "next",
      ArrowLeft: "prev",
    },
    fitToView: true,
    preload: 3,
    infinite: true,
    Panzoom: {
      maxScale: 3,
      minScale: 1,
    },
    caption: false,
    on: {
      ready: scheduleLocalSvgFancyboxMark,
      "Carousel.change": scheduleLocalSvgFancyboxMark,
      "Carousel.contentReady": scheduleLocalSvgFancyboxMark,
      "Carousel.render": scheduleLocalSvgFancyboxMark,
    },
  };

  async function ensureFancybox() {
    if (!Fancybox) {
      const mod = await import("@fancyapps/ui");
      Fancybox = mod.Fancybox;
    }
    return Fancybox;
  }

  function prepareBlurImageLinks() {
    document.querySelectorAll<HTMLAnchorElement>(blurLinkSelector).forEach((link) => {
      const image = link.querySelector<HTMLImageElement>(
        "img[data-original-src], img:not(.blur-image-placeholder)",
      );
      const original =
        link.getAttribute("data-src") ||
        image?.getAttribute("data-original-src") ||
        link.getAttribute("href");

      if (!original) return;

      link.removeAttribute("target");
      link.setAttribute("rel", "noopener");
      link.setAttribute("data-fancybox", link.closest(".custom-md") ? "article-images" : "images");
      link.setAttribute("data-src", original);
      link.setAttribute("data-type", "image");
      if (isLocalSvgUrl(original)) {
        link.setAttribute("data-local-svg", "true");
        image?.setAttribute("data-local-svg", "true");
      } else {
        link.removeAttribute("data-local-svg");
        image?.removeAttribute("data-local-svg");
      }

      const thumb =
        link.getAttribute("data-thumb-src") ||
        image?.currentSrc ||
        image?.getAttribute("src");
      if (thumb) link.setAttribute("data-thumb-src", thumb);
    });
  }

  function getBlurImageOriginal(link: HTMLAnchorElement) {
    const image = link.querySelector<HTMLImageElement>(
      "img[data-original-src], img:not(.blur-image-placeholder)",
    );
    return (
      link.getAttribute("data-src") ||
      image?.getAttribute("data-original-src") ||
      link.getAttribute("href") ||
      image?.currentSrc ||
      image?.src ||
      ""
    );
  }

  function getBlurImageThumb(link: HTMLAnchorElement) {
    const image = link.querySelector<HTMLImageElement>(
      "img:not(.blur-image-placeholder)",
    );
    return (
      link.getAttribute("data-thumb-src") ||
      image?.currentSrc ||
      image?.getAttribute("src") ||
      getBlurImageOriginal(link)
    );
  }

  function getBlurImageSlides(clickedLink: HTMLAnchorElement) {
    const scope = clickedLink.closest(".custom-md") || document;
    const group = clickedLink.getAttribute("data-fancybox");
    const links = Array.from(scope.querySelectorAll<HTMLAnchorElement>(blurLinkSelector))
      .filter((link) => {
        const original = getBlurImageOriginal(link);
        if (!original) return false;
        if (!group) return true;
        return link.getAttribute("data-fancybox") === group;
      });
    const activeIndex = Math.max(0, links.indexOf(clickedLink));
    const slides = links.map((link) => {
      const src = getBlurImageOriginal(link);
      return {
        src,
        type: "image",
        thumbSrc: getBlurImageThumb(link),
        triggerEl: link,
        class: isLocalSvgUrl(src) ? "firefly-fancybox-svg-slide" : undefined,
      };
    });

    return { slides, activeIndex };
  }

  async function openBlurImageLink(link: HTMLAnchorElement) {
    const original = getBlurImageOriginal(link);
    if (!original) return;

    prepareBlurImageLinks();
    const mod = await ensureFancybox();
    const { slides, activeIndex } = getBlurImageSlides(link);

    mod.show(slides.length > 0 ? slides : [{ src: original, type: "image" }], {
      ...commonOptions,
      startIndex: activeIndex,
      triggerEl: link,
      Carousel: {
        transition: "slide",
        preload: 2,
      },
    });
    scheduleLocalSvgFancyboxMark();
  }

  function handleBlurImageClick(event: MouseEvent) {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const link = target.closest<HTMLAnchorElement>(blurLinkSelector);
    if (!link) return;

    const original = getBlurImageOriginal(link);
    if (!original) return;

    event.preventDefault();
    event.stopPropagation();
    void openBlurImageLink(link);
  }

  async function setup() {
    const currentToken = ++setupToken;
    prepareBlurImageLinks();

    const selectors = [
      blurBoundSelector,
      rawImageSelector,
      momentLinkSelector,
      otherFancyboxSelector,
    ];
    const hasElements = selectors.some((selector) => document.querySelector(selector));

    if (!hasElements) return;

    const mod = await ensureFancybox();
    if (currentToken !== setupToken) return;

    mod.unbind(blurBoundSelector);
    mod.unbind(rawImageSelector);
    mod.unbind(momentLinkSelector);
    mod.unbind(otherFancyboxSelector);

    mod.bind(blurBoundSelector, {
      ...commonOptions,
      groupAll: false,
    });

    mod.bind(rawImageSelector, {
      ...commonOptions,
      source: (el: any) =>
        el.getAttribute("data-original-src") ||
        el.closest("a")?.getAttribute("href") ||
        el.currentSrc ||
        el.src,
      groupAll: true,
      Carousel: {
        transition: "slide",
        preload: 2,
      },
    });

    mod.bind(momentLinkSelector, {
      ...commonOptions,
      source: (el: any) => el.getAttribute("data-src") || el.getAttribute("href"),
    });

    mod.bind(otherFancyboxSelector, commonOptions);
  }

  function cleanupFancybox() {
    if (Fancybox) {
      Fancybox.close();
    }
  }

  function scheduleSetup() {
    window.setTimeout(() => void setup(), 0);
  }

  scheduleSetup();
  if (!(window as any).__fireflyBlurImageClickBound) {
    (window as any).__fireflyBlurImageClickBound = true;
    document.addEventListener("click", handleBlurImageClick, true);
  }

  document.addEventListener("astro:page-load", scheduleSetup);
  document.addEventListener("swup:content:replace", scheduleSetup);
  document.addEventListener("swup:contentReplaced", scheduleSetup);
  document.addEventListener("swup:page:view", scheduleSetup);
  document.addEventListener("swup:visit:start", cleanupFancybox);

  document.addEventListener("password:decrypted", () => {
    setTimeout(scheduleSetup, 200);
  });
</script>
